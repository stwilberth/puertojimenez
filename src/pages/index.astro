---
import Layout from '../layouts/Layout.astro';
import ContainerFluid from '../components/ContainerFluid.astro';
import Nav from '../components/Nav.astro';
import HubCard from '../components/HubCard.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { Image, type ImageMetadata } from 'astro:assets';
import puertoJimenezMap from '../assets/puerto_jimenez_map.jpg';
import { R2_IMAGES } from '../lib/r2-images';

const artists = await getCollection('artists');
const hasR2 = !!import.meta.env.R2_PUBLIC_URL;
const puertoMapForCard = hasR2 ? R2_IMAGES.mapaPuertoJimenez : puertoJimenezMap;
---

<Layout title="Welcome to Puerto Jimenez">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <main class="bg-slate-50 dark:bg-slate-950 min-h-screen">
        <Nav />
        
        <div class="relative py-24 overflow-hidden">
            <!-- Decorative Blobs -->
            <div class="absolute top-0 left-1/4 w-96 h-96 bg-green-400/20 rounded-full blur-[120px] pointer-events-none"></div>
            <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-400/20 rounded-full blur-[120px] pointer-events-none"></div>

            <ContainerFluid>
                <section class="text-center space-y-8 relative z-10">
                    <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-slate-900 dark:text-white">
                        PUERTO <span class="text-green-500">JIMENEZ</span>
                    </h1>
                    <p class="text-xl md:text-2xl text-slate-600 dark:text-slate-400 max-w-3xl mx-auto leading-relaxed font-medium flex items-center justify-center gap-3">
                        Your ultimate guide to the gateway of Corcovado National Park. 
                        <Icon name="fa6-solid:leaf" class="w-6 h-6 text-green-500 inline" />
                    </p>
                </section>
            </ContainerFluid>
        </div>
        
        <ContainerFluid>
            <div class="max-w-6xl mx-auto pb-24">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6">
                    <HubCard
                        href="/getting-puerto-jimenez"
                        title="Getting Here"
                        description="Plan your journey by air, land, or sea. All roads lead to paradise."
                        icon="fa6-regular:map"
                        iconColor="text-blue-300"
                        hoverTitle="group-hover:text-blue-300"
                        gradient="from-blue-900/40 to-cyan-700/20"
                        cta="Explore Routes"
                        featured
                        bgImage={puertoMapForCard}
                        class="lg:col-span-3 lg:row-span-2"
                    />

                    <HubCard
                        href="/tours-and-activities"
                        title="Tours & Activities"
                        description="Guided wildlife treks and mangrove adventures."
                        icon="fa6-regular:compass"
                        iconColor="text-green-500"
                        hoverTitle="group-hover:text-green-500"
                        gradient="from-green-600/10 to-emerald-500/10"
                        class="lg:col-span-3 lg:row-span-2"
                    />

                    <!-- Artisans - Full width, prominent -->
                    <a href="/artisans" class="group lg:col-span-6">
                        <div class="relative h-80 md:h-96 bg-slate-900 rounded-[2.5rem] shadow-xl hover:shadow-2xl transition-all duration-500 overflow-hidden">
                            <!-- Background Slider -->
                            <div class="absolute inset-0 z-0">
                                <div class="swiper artisan-mini-swiper h-full w-full">
                                    <div class="swiper-wrapper">
                                        {artists.map(artist => {
                                            const isHubert = artist.data.name.toLowerCase().includes('hubert');
                                            const hubertOverride = "/uploads/puertojimenez/1787800758850-hubert.jpeg";
                                            return (
                                            <div class="swiper-slide">
                                                {isHubert ? (
                                                    <img src={hubertOverride} alt={artist.data.name} width="1200" height="500" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[3000ms]" loading="lazy" />
                                                ) : artist.data.image && (
                                                    <Image src={artist.data.image as ImageMetadata} alt={artist.data.name} width={1200} height={500} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[3000ms]" />
                                                )}
                                            </div>
                                        )})}
                                    </div>
                                </div>
                            </div>

                            <!-- Gradient overlay -->
                            <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/40 to-black/70 z-10"></div>

                            <!-- Content -->
                            <div class="absolute inset-0 z-20 p-6 md:p-8 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center gap-3 mb-4">
                                        <Icon name="fa6-solid:palette" class="w-6 h-6 text-orange-400" />
                                        <span class="text-orange-400 font-bold uppercase tracking-widest text-2xl md:text-4xl">Local Artisans</span>
                                    </div>
                                    <h2 class="text-xl md:text-2xl font-black text-white leading-tight max-w-xl">
                                        Authentic Jiménez<br/>Souvenirs
                                    </h2>
                                    <p class="text-white/60 mt-3 text-base md:text-lg max-w-md">
                                        Handcrafted in the Osa Peninsula. Every Friday at the Martina fair in Matapalo.
                                    </p>
                                </div>


                            </div>
                        </div>
                    </a>

                    <HubCard
                        href="/accommodation"
                        title="Stay"
                        description="Hotels, lodges & eco-cabinas"
                        icon="fa6-solid:bed"
                        iconColor="text-amber-500"
                        hoverTitle="group-hover:text-amber-500"
                        gradient="from-amber-600/10 to-yellow-500/10"
                        class="lg:col-span-3 h-48"
                    />

                    <HubCard
                        href="/restaurants"
                        title="Dine"
                        description="Restaurants & local sodas"
                        icon="fa6-solid:utensils"
                        iconColor="text-red-500"
                        hoverTitle="group-hover:text-red-500"
                        gradient="from-red-600/10 to-rose-500/10"
                        class="lg:col-span-3 h-48"
                    />
                </div>

                <!-- Essential Tips Section -->
                <section class="mt-24">
                    <div class="text-center mb-12">
                        <h2 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4 tracking-tight">
                            Essential <span class="text-emerald-500">Tips</span> for Your Visit
                        </h2>
                        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                            Make the most of your Puerto Jiménez adventure with these local insights.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <!-- Corcovado Tip -->
                        <a href="/corcovado" class="group bg-white dark:bg-slate-900 p-8 rounded-[2rem] shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-100 dark:border-slate-800 relative overflow-hidden block">
                            <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
                                <Icon name="fa6-solid:calendar-check" class="w-16 h-16 text-emerald-500" />
                            </div>
                            <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/30 rounded-xl flex items-center justify-center mb-6">
                                <Icon name="fa6-solid:calendar-check" class="w-6 h-6 text-emerald-600 dark:text-emerald-400" />
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Book Corcovado Early</h3>
                            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
                                Daily capacity is strictly limited. We recommend booking at least 4-6 weeks in advance during peak season.
                            </p>
                            <span class="text-emerald-500 text-sm font-bold flex items-center gap-2 group-hover:gap-3 transition-all">
                                Learn More <Icon name="fa6-solid:arrow-right" class="w-3 h-3" />
                            </span>
                        </a>

                        <!-- Cash Tip -->
                        <div class="group bg-white dark:bg-slate-900 p-8 rounded-[2rem] shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-100 dark:border-slate-800 relative overflow-hidden">
                            <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
                                <Icon name="fa6-solid:money-bill-wave" class="w-16 h-16 text-amber-500" />
                            </div>
                            <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/30 rounded-xl flex items-center justify-center mb-6">
                                <Icon name="fa6-solid:money-bill-wave" class="w-6 h-6 text-amber-600 dark:text-amber-400" />
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Local Currency</h3>
                            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                                While USD is widely accepted, carrying Costa Rican Colones (CRC) is best for local sodas and small shops.
                            </p>
                        </div>

                        <!-- Respect Wildlife Tip -->
                        <div class="group bg-white dark:bg-slate-900 p-8 rounded-[2rem] shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-100 dark:border-slate-800 relative overflow-hidden">
                            <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
                                <Icon name="fa6-solid:leaf" class="w-16 h-16 text-green-500" />
                            </div>
                            <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center mb-6">
                                <Icon name="fa6-solid:leaf" class="w-6 h-6 text-green-600 dark:text-green-400" />
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Respect the Wild</h3>
                            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                                Keep a safe distance from wildlife. Never feed animals and always follow your guide's instructions.
                            </p>
                        </div>
                    </div>
                </section>
            </div>
        </ContainerFluid>
    </main>
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script is:inline>
        new Swiper('.artisan-mini-swiper', {
            effect: 'fade',
            fadeEffect: {
                crossFade: true
            },
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            loop: true,
            speed: 1000,
        });
    </script>
</Layout>

<style>
    @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }
    
    .floating {
        animation: float 4s ease-in-out infinite;
    }
</style>

