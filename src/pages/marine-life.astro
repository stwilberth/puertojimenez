---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ContainerFluid from '../components/ContainerFluid.astro';
import CallToAction from '../components/CallToAction.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Marine Life & Golfo Dulce Guide | Puerto Jiménez">
    <main class="bg-slate-50 dark:bg-slate-950 min-h-screen">
        <Nav />

        <!-- Hero Section -->
        <div class="relative h-[60vh] flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 z-0">
                <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-slate-50 dark:to-slate-950 z-10"></div>
                <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&q=80&w=2000')] bg-cover bg-center animate-slow-zoom"></div>
            </div>

            <ContainerFluid>
                <div class="relative z-20 text-center space-y-4">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/20 backdrop-blur-md border border-blue-500/30 text-blue-300 text-sm font-bold uppercase tracking-widest mb-4">
                        <Icon name="fa6-solid:water" class="w-4 h-4" />
                        The Golfo Dulce Sanctuary
                    </div>
                    <h1 class="text-6xl md:text-8xl font-black text-white tracking-tighter uppercase">
                        Marine <span class="text-blue-400">Life</span>
                    </h1>
                    <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto font-medium">
                        Explore the crystal clear waters of one of only four tropical fjords in the world.
                    </p>
                </div>
            </ContainerFluid>
        </div>

        <ContainerFluid>
            <div class="max-w-5xl mx-auto -mt-20 relative z-30 pb-24">
                <!-- Highlights Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                    <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl shadow-xl border border-slate-100 dark:border-slate-800">
                        <Icon name="fa6-solid:shrimp" class="w-8 h-8 text-blue-500 mb-4" />
                        <h3 class="font-bold text-slate-900 dark:text-white mb-2">Whale Watching</h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Humpback whales visit from August to October and January to March.</p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl shadow-xl border border-slate-100 dark:border-slate-800">
                        <Icon name="fa6-solid:fish" class="w-8 h-8 text-cyan-500 mb-4" />
                        <h3 class="font-bold text-slate-900 dark:text-white mb-2">Dolphin Pods</h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Bottlenose and Spinner dolphins are seen year-round in the gulf.</p>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl shadow-xl border border-slate-100 dark:border-slate-800">
                        <Icon name="fa6-solid:star" class="w-8 h-8 text-amber-500 mb-4" />
                        <h3 class="font-bold text-slate-900 dark:text-white mb-2">Bioluminescence</h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Magical night kayaking tours to see glowing plankton.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                    <!-- Main Content -->
                    <div class="lg:col-span-2 space-y-12">
                        <section>
                            <h2 class="text-3xl font-black text-slate-900 dark:text-white mb-6">The Golfo Dulce</h2>
                            <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                                The Golfo Dulce (Sweet Gulf) is a unique ecosystem. Its deep, calm waters serve as a nursery for humpback whales and multiple species of sharks, including the hammerhead and whale shark.
                            </p>
                            <div class="relative h-64 rounded-[2.5rem] overflow-hidden group shadow-2xl">
                                <img src="https://images.unsplash.com/photo-1551244072-5d12893278ab?auto=format&fit=crop&q=80&w=1200" class="w-full h-full object-cover" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-8">
                                    <p class="text-white font-medium italic">"A sanctuary for marine giants."</p>
                                </div>
                            </div>
                        </section>

                        <section class="space-y-8">
                            <h2 class="text-3xl font-black text-slate-900 dark:text-white mb-6">Top Activities</h2>
                            
                            <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl shadow-lg border border-slate-100 dark:border-slate-800 flex flex-col md:flex-row gap-8 items-center">
                                <div class="w-full md:w-1/3 aspect-square rounded-2xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                                    <Icon name="fa6-solid:sailboat" class="w-16 h-16 text-blue-500" />
                                </div>
                                <div class="flex-1">
                                    <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Whale & Dolphin Watching</h3>
                                    <p class="text-slate-600 dark:text-slate-400 mb-4">Board a small boat with an expert captain to witness the majestic humpback whales and playful dolphins.</p>
                                    <span class="text-xs font-bold uppercase tracking-widest text-blue-500">Season: Aug - Oct & Jan - Mar</span>
                                </div>
                            </div>

                            <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl shadow-lg border border-slate-100 dark:border-slate-800 flex flex-col md:flex-row gap-8 items-center">
                                <div class="w-full md:w-1/3 aspect-square rounded-2xl bg-cyan-100 dark:bg-cyan-900/30 flex items-center justify-center">
                                    <Icon name="fa6-solid:moon" class="text-cyan-500 w-16 h-16" />
                                </div>
                                <div class="flex-1">
                                    <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Bioluminescence Kayaking</h3>
                                    <p class="text-slate-600 dark:text-slate-400 mb-4">One of the most magical experiences in Puerto Jiménez. Paddle into the darkness and watch the water glow with every stroke.</p>
                                    <span class="text-xs font-bold uppercase tracking-widest text-cyan-500">Available: Year-round (Best on New Moon)</span>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- Sidebar -->
                    <div class="space-y-8">
                        <div class="bg-blue-600 rounded-[2rem] p-8 text-white shadow-xl shadow-blue-500/20">
                            <h3 class="text-2xl font-bold mb-4">Conservation</h3>
                            <p class="text-blue-100 text-sm leading-relaxed mb-6">
                                The Golfo Dulce is a protected area. Please choose operators who follow responsible whale watching practices and keep a respectful distance.
                            </p>
                            <div class="p-4 bg-white/10 rounded-2xl border border-white/20">
                                <p class="text-xs font-bold uppercase mb-2">Pro Tip:</p>
                                <p class="text-sm">Polarized sunglasses are essential to see through the water surface!</p>
                            </div>
                        </div>
                    </div>
                </div>

                <CallToAction
                    title="Ready to hit the water?"
                    description="Explore our list of certified boat captains and marine tour operators."
                    buttonText="See Operators"
                />
            </div>
        </ContainerFluid>
    </main>
</Layout>

<style>
    @keyframes slow-zoom {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }
    .animate-slow-zoom {
        animation: slow-zoom 20s ease-in-out infinite alternate;
    }
</style>
