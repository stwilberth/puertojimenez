# R2 Cloudflare - Bucket wilberth
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret_key
R2_BUCKET_NAME=wilberth
# URL pública del bucket (ej: https://pub-xxxxx.r2.dev  o dominio custom https://cdn.tudominio.com)
R2_PUBLIC_URL=https://pub-tu-id.r2.dev

# Admin dashboard - solo contraseña (sin usuario)
ADMIN_PASSWORD=Jair2018_*
# Alternativa: igual que arriba, env var puede sobreescribir el default hardcodeado
